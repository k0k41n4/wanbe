---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// Fetch all posts and sort by newest
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Minimalist Space | Articles & Notes">
  <main class="max-w-4xl mx-auto px-6 py-12">
    
    {/* Homepage Hero Headline */}
    <section class="text-center mb-14">
      <span class="text-[10px] uppercase font-mono tracking-widest bg-rose-500/10 text-rose-400 border border-rose-500/20 px-3 py-1 rounded-full inline-block mb-3">
        Minimalist Reading Space
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-neutral-100 leading-tight">
        Exploring Ideas & Notes
      </h1>
      <p class="text-sm text-neutral-400 mt-3 max-w-md mx-auto font-light">
        A curated collection of articles on minimalist living, daily systems, and digital assets.
      </p>
    </section>

    {/* Article Grid Cards */}
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {posts.map((post) => (
        <a 
          href={`/${post.id}`} 
          class="group flex flex-col bg-neutral-950 border border-neutral-800/80 hover:border-neutral-700 rounded-2xl overflow-hidden transition-all duration-300 shadow-md hover:shadow-xl hover:shadow-rose-950/20 hover:-translate-y-1"
        >
          {/* Thumbnail Image */}
          {post.data.heroImage ? (
            <div class="aspect-[16/9] w-full overflow-hidden bg-neutral-900 border-b border-neutral-800/60 relative">
              <Image 
                src={post.data.heroImage} 
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          ) : (
            <div class="aspect-[16/9] w-full bg-neutral-900 border-b border-neutral-800/60 flex items-center justify-center text-xs text-neutral-600 font-mono">
              [No Image]
            </div>
          )}

          {/* Card Body */}
          <div class="p-6 flex flex-col justify-between flex-grow">
            <div>
              <time class="text-[10px] text-rose-400 font-mono tracking-wider block mb-2 uppercase">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              
              <h2 class="text-lg font-bold text-neutral-100 group-hover:text-rose-400 transition-colors line-clamp-2 leading-snug mb-2">
                {post.data.title}
              </h2>

              <p class="text-xs text-neutral-400 line-clamp-3 font-light leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <span class="text-xs text-neutral-500 group-hover:text-neutral-200 transition-colors font-mono inline-flex items-center gap-1 mt-auto">
              Read article &rarr;
            </span>
          </div>
        </a>
      ))}
    </section>

  </main>
</Layout>